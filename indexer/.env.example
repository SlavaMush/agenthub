CHAIN_ID=84532
PORT=4001
# Public Base Sepolia RPC is the default. Override if you hit rate limits.
# RPC_URL=https://sepolia.base.org
# Unset or "latest" follows the chain tip (no historical backfill).
# Set to the AgentHub deploy block after `forge script`.
# START_BLOCK=latest
SYNC_INTERVAL_MS=12000
CATALOG_PATH=./data/catalog.json
# Optional overrides; otherwise packages/config deployments + chain identity registry.
# AGENT_HUB_ADDRESS=
# MEMORY_MARKET_ADDRESS=
# SERVICE_ESCROW_ADDRESS=
# IDENTITY_REGISTRY=
